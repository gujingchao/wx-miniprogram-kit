.chips { display: flex; flex-wrap: wrap; }
.chip {
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  background: #f2f3f5;
  color: #646566;
  font-size: 24rpx;
  margin: 0 12rpx 12rpx 0;
}
.chip--on { background: #07c160; color: #fff; }
.real__item { display: flex; padding: 20rpx 0; }
.real__avatar {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: #07c160; color: #fff; text-align: center; line-height: 80rpx;
  margin-right: 24rpx; font-weight: 600;
}
.real__title { font-size: 30rpx; font-weight: 600; }
.real__desc { font-size: 24rpx; color: #9ca3af; margin-top: 8rpx; }
