<view class="wk-page">
  <view class="wk-card__desc" style="padding: 0 8rpx 16rpx;">内置 required / min / max / pattern / mobile / email，以及自定义 validator。</view>

  <wk-form id="form" model="{{form}}" rules="{{rules}}">
    <wk-form-item label="姓名" prop="name" required>
      <input class="field" placeholder="请输入姓名" value="{{form.name}}" data-prop="name" bindinput="onInput" />
    </wk-form-item>
    <wk-form-item label="手机号" prop="mobile" required>
      <input class="field" type="number" maxlength="11" placeholder="11 位手机号" value="{{form.mobile}}" data-prop="mobile" bindinput="onInput" />
    </wk-form-item>
    <wk-form-item label="邮箱" prop="email">
      <input class="field" placeholder="选填" value="{{form.email}}" data-prop="email" bindinput="onInput" />
    </wk-form-item>
    <wk-form-item label="验证码" prop="code" required>
      <input class="field" type="number" maxlength="6" placeholder="6 位数字" value="{{form.code}}" data-prop="code" bindinput="onInput" />
    </wk-form-item>
    <wk-form-item label="备注" prop="remark" border="{{false}}">
      <textarea class="area" placeholder="自定义规则：不能包含「测试」" value="{{form.remark}}" data-prop="remark" bindinput="onInput" auto-height />
    </wk-form-item>
  </wk-form>

  <view class="wk-btn wk-btn--block" bindtap="onSubmit">提交校验</view>
  <view class="wk-btn wk-btn--block wk-btn--plain" bindtap="onReset">重置</view>
</view>
