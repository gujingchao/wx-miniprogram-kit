.wk-skeleton {
  width: 100%;
}

.wk-skeleton__item {
  display: flex;
  padding: 24rpx 0;
}

.wk-skeleton__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 24rpx;
  background: #f2f3f5;
}

.wk-skeleton__avatar--lg {
  width: 120rpx;
  height: 120rpx;
}

.wk-skeleton__content {
  flex: 1;
  min-width: 0;
}

.wk-skeleton__title {
  height: 32rpx;
  width: 46%;
  border-radius: 8rpx;
  background: #f2f3f5;
  margin-bottom: 20rpx;
}

.wk-skeleton__row {
  height: 24rpx;
  border-radius: 8rpx;
  background: #f2f3f5;
  margin-bottom: 16rpx;
}

.wk-skeleton__card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.wk-skeleton__banner {
  height: 200rpx;
  background: #f2f3f5;
}

.wk-skeleton__banner--lg {
  height: 320rpx;
  border-radius: 16rpx;
}

.wk-skeleton__card-body {
  padding: 24rpx;
}

.wk-skeleton--animate {
  background-image: linear-gradient(90deg, #f2f3f5 25%, #e8e9eb 37%, #f2f3f5 63%);
  background-size: 400% 100%;
  background-color: #f2f3f5;
  animation: wk-skeleton-loading 1.4s ease infinite;
}

@keyframes wk-skeleton-loading {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.wk-skeleton__real {
  width: 100%;
}
