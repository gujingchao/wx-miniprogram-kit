.wk-uploader {
  display: flex;
  flex-wrap: wrap;
}

.wk-uploader__item,
.wk-uploader__add {
  width: 200rpx;
  height: 200rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  background: #f7f8fa;
}

.wk-uploader__image {
  width: 100%;
  height: 100%;
}

.wk-uploader__delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 36rpx;
  text-align: center;
  border-bottom-left-radius: 12rpx;
}

.wk-uploader__mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wk-uploader__mask--fail {
  background: rgba(238, 10, 36, 0.55);
}

.wk-uploader__meta {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.4);
  text-align: center;
  padding: 4rpx 0;
}

.wk-uploader__add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #dcdee0;
  background: #fafafa;
  box-sizing: border-box;
}

.wk-uploader__plus {
  width: 48rpx;
  height: 48rpx;
  position: relative;
  margin-bottom: 8rpx;
}

.wk-uploader__plus::before,
.wk-uploader__plus::after {
  content: '';
  position: absolute;
  background: #969799;
}

.wk-uploader__plus::before {
  left: 22rpx;
  top: 8rpx;
  width: 4rpx;
  height: 32rpx;
}

.wk-uploader__plus::after {
  left: 8rpx;
  top: 22rpx;
  width: 32rpx;
  height: 4rpx;
}

.wk-uploader__add-text {
  font-size: 22rpx;
  color: #969799;
}
